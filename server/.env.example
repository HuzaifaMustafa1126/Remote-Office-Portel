# Use production in Hostinger. Do not commit a populated .env file.
NODE_ENV=production
PORT=4000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

JWT_SECRET=
JWT_EXPIRES_IN=8h

FRONTEND_URL=https://domain-name.com
# Optional comma-separated override/additional origins. When set, this takes
# precedence over FRONTEND_URL. Example: https://domain-name.com
# CORS_ORIGIN=

# Number of trusted reverse proxies directly in front of Express. The default
# is 1 in production (Hostinger managed Node proxy) and 0 in development.
# Keep the Node port private/firewalled. If a controlled diagnostic shows an
# additional proxy in req.ips, set this to the verified hop count and restart.
# TRUST_PROXY_HOPS=1

# Temporary login-only network diagnostics. Logs only resolved/socket IPs and
# X-Forwarded-For/X-Real-IP; never credentials, cookies, or authorization.
IP_DIAGNOSTICS=false

# Fail startup checks and unusually long HTTP requests instead of hanging.
STARTUP_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=30000

# Only needed temporarily when deliberately running `npm run seed:admin`.
# Do not retain these values in the production environment after seeding.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
