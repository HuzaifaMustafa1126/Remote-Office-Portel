# Use production in Hostinger. Do not commit a populated .env file.
NODE_ENV=production
PORT=4000

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECT_TIMEOUT_MS=10000
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=100

JWT_SECRET=
JWT_EXPIRES_IN=8h

FRONTEND_URL=https://portel.abdalimarketing.com
# Optional comma-separated override/additional origins. When set, this takes
# precedence over FRONTEND_URL. Example: https://portel.example.com,http://localhost:5173
# CORS_ORIGIN=

# Number of trusted reverse proxies in front of Express. Keep 0 on localhost.
# Set to the verified Hostinger proxy hop count only after confirming topology.
TRUST_PROXY_HOPS=0

# Fail startup checks and unusually long HTTP requests instead of hanging.
STARTUP_TIMEOUT_MS=30000
REQUEST_TIMEOUT_MS=30000

# Only needed temporarily when deliberately running `npm run seed:admin`.
# Do not retain these values in the production environment after seeding.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
