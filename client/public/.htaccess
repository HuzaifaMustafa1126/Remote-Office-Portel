Options -MultiViews
RewriteEngine On

# Serve existing build files directly. All other paths use the SPA shell
# internally, without redirecting the browser or rewriting / back to itself.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
# Never let the SPA fallback hide a missing Node/API proxy as HTML.
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header always set Cache-Control "no-store, no-cache, must-revalidate"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>

  <FilesMatch "[-][A-Za-z0-9_-]{8,}\.(js|css)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|gif|svg|ico|woff2?|ttf|otf)$">
    Header always set Cache-Control "public, max-age=86400"
  </FilesMatch>
</IfModule>
